# SpendZen Server Environment Variables

# Server Configuration
PORT=5000
NODE_ENV=development

# Database (SQLite for development)
DATABASE_URL="file:./dev.db"

# JWT Secret - CHANGE THIS TO A RANDOM STRING IN PRODUCTION
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# CORS - Frontend URL (update in production)
ALLOWED_ORIGINS=http://localhost:5173

# Notes:
# - For production, use PostgreSQL: DATABASE_URL="postgresql://user:pass@host:5432/dbname"
# - Generate strong JWT_SECRET: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# - Update ALLOWED_ORIGINS to your Vercel URL
